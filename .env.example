SYNQ_NETWORK=local/anvil
SYNQ_MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
SYNQ_LOCAL_RPC_URL=http://127.0.0.1:8545
SYNQ_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
SYNQ_TESTNET_KEY_FILE=
SYNQ_READ_MODEL_PATH=artifacts/local/read-model.json
SYNQ_PORT=3000
ENVIO_RPC_URL=http://127.0.0.1:8545
ENVIO_CHAIN_ID=31337
ENVIO_EXECUTION_MODULE_ADDRESS=
ENVIO_MANDATE_REGISTRY_ADDRESS=
ENVIO_SANDBOX_ACCOUNT_ADDRESS=
ENVIO_START_BLOCK=0

SYNQ_PROOF_ARTIFACT=artifacts/local/demonstration.json
SYNQ_TEST_DATABASE_URL=postgresql://postgres:synq_local@127.0.0.1:55432/synq_test
SYNQ_TEST_REDIS_URL=redis://127.0.0.1:56379
SYNQ_ENVIO_PROOF_ARTIFACT=

# P06-P10 run: mainnet value movement is disabled
SYNQ_ALLOW_MAINNET_BROADCAST=false
SYNQ_MAINNET_CANARY_MAX_USD=0
# Model providers (vendor-neutral Brain ports)
QWEN_API_KEY=
QWEN_BASE_URL=
KIMI_API_KEY=
KIMI_BASE_URL=

# Trusted route identity; unrelated treasury mandates never widen Synq Send.
SYNQ_SEND_MANDATE_ID=synq_send

# WhatsApp Cloud API (official Meta Graph API, 1:1 chats only). Unset: BLOCKED_EXTERNAL.
SYNQ_WHATSAPP_TOKEN=
SYNQ_WHATSAPP_PHONE_NUMBER_ID=
SYNQ_WHATSAPP_APP_SECRET=
SYNQ_WHATSAPP_VERIFY_TOKEN=
# Comma-separated wa_ids (digits, country code first) Synq may message or hear from.
SYNQ_WHATSAPP_ALLOWED_WA_IDS=
SYNQ_WHATSAPP_GRAPH_VERSION=

# Container stack (infra/compose.prod.yaml); names only, values come from the environment.
POSTGRES_PASSWORD=
SYNQ_API_HOST=
SYNQ_API_PORT=
SYNQ_API_PUBLISH_PORT=
SYNQ_WEB_PUBLISH_PORT=
SYNQ_API_ORIGIN=
SYNQ_SECRETS_DIR=
SYNQ_PROFILE=
SYNQ_RP_ID=
SYNQ_ORIGIN=
SYNQ_WEB_BASE_URL=
SYNQ_API_ADMIN_TOKEN=
SYNQ_KERNEL_AUDIT_KEY_FILE=
SYNQ_KERNEL_PLUGINS_FILE=
SYNQ_TRUST_PROXY=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
SYNQ_WORKFLOW_MANIFEST=
SYNQ_WORKFLOW_HEALTH_HOST=
SYNQ_WORKFLOW_HEALTH_PORT=

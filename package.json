{
  "name": "synq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint packages apps workers plugins scripts tests --no-warn-ignored && node scripts/architecture.mjs",
    "format": "prettier --write 'packages/**/*.ts' 'apps/**/*.{ts,tsx}' 'workers/**/*.ts' 'plugins/**/*.ts' 'tests/**/*.ts' 'scripts/*.{ts,mjs}'",
    "format:check": "prettier --check 'packages/**/*.ts' 'apps/**/*.{ts,tsx}' 'workers/**/*.ts' 'plugins/**/*.ts' 'tests/**/*.ts' 'scripts/*.{ts,mjs}'",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:contracts": "forge build --root contracts --offline && forge test --root contracts --offline",
    "test:integration": "forge build --root contracts --offline && vitest run tests/integration tests/arc/finance.integration.test.ts tests/arc/telegram-guest.integration.test.ts tests/cre/risk-gate.integration.test.ts tests/read-model/storage.integration.test.ts tests/identity/services.integration.test.ts tests/api/v1.integration.test.ts tests/execution/reorg.integration.test.ts tests/treasury tests/funding/anvil.integration.test.ts tests/funding/storage.integration.test.ts tests/send/recovery.integration.test.ts tests/world-model/world.integration.test.ts tests/channels/postgres.integration.test.ts tests/channels/telegram-slice.integration.test.ts tests/settlement/reservations.integration.test.ts tests/settlement/fabric.integration.test.ts tests/profile-vault/postgres.integration.test.ts tests/channels/mandate-approval.integration.test.ts tests/channels/brain-channel.integration.test.ts tests/api/lithic-webhook.integration.test.ts tests/metamask-delegation/attempt-ledger.integration.test.ts tests/gauntlet/integrated-attacks.integration.test.ts tests/durable/execution.integration.test.ts tests/durable/finance-team.integration.test.ts tests/durable/governance.integration.test.ts tests/durable/arc-indexer.integration.test.ts tests/durable/cctp-gateway.integration.test.ts tests/durable/delegation-critic.integration.test.ts tests/allocations/split.integration.test.ts tests/dealroom/postgres.integration.test.ts tests/dealroom/escrow-durable.integration.test.ts tests/agent-team/risk-postgres.integration.test.ts tests/agent-team/agent-team-live.integration.test.ts tests/group-funds/fund-store.integration.test.ts tests/duffel/attempts.integration.test.ts tests/cross-cutting/crash-recovery.integration.test.ts tests/cross-cutting/kernel.integration.test.ts tests/cross-cutting/funds-load.integration.test.ts tests/workspaces/postgres.integration.test.ts tests/workspaces/vault-execution.integration.test.ts tests/workspaces/channel-links.integration.test.ts tests/workspaces/finance.integration.test.ts tests/workspaces/delivery.integration.test.ts tests/workspaces/invoices.integration.test.ts tests/workspaces/app-api.integration.test.ts tests/workspaces/leads.integration.test.ts tests/workspaces/agent-events.integration.test.ts tests/workspaces/amane-pay.integration.test.ts tests/workspaces/notifications.integration.test.ts",
    "demo": "node --import tsx apps/demo/src/local.ts",
    "demo:testnet": "node --import tsx apps/demo/src/testnet.ts",
    "test:testnet": "vitest run --config tests/e2e/vitest.testnet.config.ts",
    "architecture": "node scripts/architecture.mjs",
    "preflight": "node --import tsx scripts/preflight.ts",
    "dev": "node --import tsx apps/api/src/server.ts",
    "verify": "pnpm preflight && pnpm typecheck && pnpm lint && pnpm secrets && pnpm format:check && pnpm build && pnpm test && pnpm test:contracts && pnpm test:integration",
    "secrets": "node scripts/secrets.mjs",
    "test:indexer": "SYNQ_RM_FORK_TESTS=1 vitest run tests/read-model/envio.integration.test.ts",
    "indexer:codegen": "node --import tsx scripts/envio-codegen.ts",
    "indexer:typecheck": "pnpm --filter @synq/envio typecheck",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "stack:prod:up": "docker compose -f infra/compose.prod.yaml up -d --build --wait",
    "tunnel": "sh scripts/tunnel.sh",
    "indexer:start": "node --import tsx scripts/indexer-local.ts",
    "indexer:arc": "node --import tsx apps/api/src/arc-indexer.ts",
    "indexer:testnet-evidence": "node --import tsx scripts/envio-testnet-evidence.ts",
    "testnet:probe": "node --import tsx scripts/testnet-probe.ts",
    "test:report": "node scripts/test-report.mjs",
    "test:schema-compat": "vitest run tests/domain/schema-compat.test.ts",
    "test:plugins": "vitest run tests/plugins",
    "metamask:delegation-live": "node --import tsx scripts/metamask-delegation-live.ts",
    "test:mm-plugin": "npm --prefix packages/metamask-synq-plugin run typecheck && npm --prefix packages/metamask-synq-plugin test",
    "test:live:p10": "SYNQ_P10_LIVE=1 vitest run --config tests/perpl/vitest.live.config.ts",
    "sources:resolve": "node scripts/resolve-sources.mjs",
    "registry:probe": "node --import tsx scripts/testnet-probe.ts",
    "indexer:env": "node --import tsx scripts/envio-env.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:live:p09": "SYNQ_LIVE_P09=1 vitest run tests/kuru/live.p09.test.ts tests/cre/live.p09.test.ts",
    "test:workflow": "vitest run --config tests/workflow/vitest.workflow.config.ts",
    "workflow:dev": "node --import tsx workers/workflow/src/dev.ts",
    "test:brain": "vitest run tests/brain tests/world-model",
    "brain:demo": "node --import tsx scripts/brain-demo.ts",
    "demo:send": "node --import tsx apps/demo/src/send.ts",
    "test:live:p08": "SYNQ_LIVE_P08=1 vitest run tests/funding/p08.live.test.ts",
    "funding:evidence": "node --import tsx scripts/funding-evidence.ts",
    "demo:cross-phase": "tsx scripts/cross-phase-demo.ts",
    "test:gauntlet": "tsx scripts/security-gauntlet.ts",
    "channels:telegram:poll": "node --import tsx apps/api/src/channels-poll.ts",
    "demo:telegram": "node --import tsx apps/demo/src/telegram.ts",
    "demo:telegram:rehearse": "node --import tsx apps/demo/src/telegram-rehearsal.ts",
    "channels:imessage": "node --import tsx apps/api/src/imessage-bridge.ts",
    "channels:imessage:probe": "node --import tsx apps/api/src/imessage-bridge.ts --probe",
    "channels:imessage:find-chat": "node --import tsx apps/api/src/imessage-bridge.ts --find-chat",
    "ios:messages:check": "sh apps/ios-messages/check.sh",
    "check:no-demo-data": "node scripts/check-no-demo-data.mjs"
  },
  "dependencies": {
    "zod": "4.6.5",
    "viem": "2.57.4",
